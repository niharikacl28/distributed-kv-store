cat > .gitignore <<'EOF'
# Maven build output
target/

# Java compiled files
*.class

# IDE files
.idea/
.vscode/
*.iml
.settings/
.project
.classpath

# macOS files
.DS_Store

# Logs
*.log

# Temporary files
*.tmp
EOF
# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/npm-debug.log*
